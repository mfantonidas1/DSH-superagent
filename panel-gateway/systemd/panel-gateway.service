[Unit]
Description=superagent 面板用户名密码门禁（用户级 nginx 反代 127.0.0.1:3082 → 172.16.2.238:3083）
Documentation=file://%h/dsh-workspace/panel-gateway/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# token.conf 必须存在，否则 nginx 的 include 会失败；起服务前先确保一次。
# `-` 前缀必须保留：失败的 ExecStartPre 不应阻止 nginx 本体启动
# （面板暂时没起时，nginx 仍可服务并给出干净的 401/502）。
ExecStartPre=-/usr/bin/env bash %h/dsh-workspace/panel-gateway/bin/refresh-token.sh
ExecStart=/usr/sbin/nginx -p %h/dsh-workspace/panel-gateway -c conf/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -p %h/dsh-workspace/panel-gateway -c conf/nginx.conf -s reload
Restart=always
RestartSec=3

[Install]
WantedBy=default.target